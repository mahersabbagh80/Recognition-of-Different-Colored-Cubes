<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>recognition_of_different_colored_cubes</name>
  <version>0.1.0</version>
  <description>Detect and classify differently colored cubes using the JetRover depth camera and ROS 2</description>
  <maintainer email="mahersabbagh80@gmail.com">Maher Alshirazi Alsabbagh</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>interfaces</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>numpy</exec_depend>
  <exec_depend>PIL</exec_depend>
  <exec_depend>torch</exec_depend>
  <exec_depend>torchvision</exec_depend>
  <!-- tensorrt + pycuda are Jetson-only and live outside the apt rosdep set;
       they are installed on the JetRover image by HiWonder (see docs/technical-stack.md). -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
