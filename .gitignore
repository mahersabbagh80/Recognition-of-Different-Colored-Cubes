# ROS 2 colcon build folders
build/
install/
log/

# Python cache and metadata
__pycache__/
*.pyc
*.egg-info/
.built_by
COLCON_IGNORE

# Model artifacts (large; obtain via Roboflow or train locally)
models/*
!models/.gitkeep
!models/README.md

# YOLOv5 / training outputs (local fine-tune on dev PC)
runs/
wandb/

# Stray weights files that Ultralytics may download to CWD
*.pt

# Jupyter
.ipynb_checkpoints/

# Captured test images and eval outputs (optional local data)
evaluation/captures/
evaluation/results/
evaluation/m2-visualizations/
# M4/M6 JetRover camera samples and ROS bags (gitignored; reproducible from scripts/capture_frames.py)
evaluation/camera_samples/
evaluation/bags/
# M5 evaluation data — bag captures are gitignored; the report is tracked.
evaluation/m5_live/bag_*/
evaluation/m5_live/*.json
!evaluation/m5_live/report.md
!evaluation/m5_live/.gitkeep
# M4 inference outputs (annotated PNGs + detections.json)
evaluation/m4b_predictions/
evaluation/m4b_predictions_v1_subprocess/
# M4c geometry-filter outputs — JSON + report tracked, annotated PNGs and depth sanity PNGs ignored
evaluation/m4c_geometry_filter/annotated_cubes/
evaluation/m4c_geometry_filter/_depth_sanity_*.png
# M3c hard-negative fine-tune outputs (annotated PNGs + detections.json)
# Report.md is intentionally NOT excluded — it is the evidence document.
evaluation/m3c_predictions/*.png
evaluation/m3c_predictions_empty/*.png
evaluation/m3c_predictions_hardneg/*.png
evaluation/m3c_roboflow_valid/*.png

# Local tester harness (verification scripts and their results, e.g. _m2m3_verify.*)
evaluation/_*.py
evaluation/_*.json

# Environment and secrets
.env
.venv/
venv/

# Local M2 training venv (torch / ultralytics / onnx). Optional local dev tool;
# reproducible from the training command in models/README.md.
.venv-m2/
.yolo_config/

# M2 normalized dataset (regenerable via scripts/normalize_dataset.py)
data/roboflow_det/

# M2 raw dataset (downloaded from Roboflow manually or via SDK; never commit images)
data/roboflow/
# M3c hard-negative fine-tune dataset (regenerable via scripts/build_hardneg_dataset.py)
data/hardneg/

# OS / editor
.DS_Store
*~
